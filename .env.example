# =============================================================================
# Backend Project — Environment Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# URL of the frontend client (used for CORS and redirect URLs)
CLIENT_URL=http://localhost:5173

# Additional CORS origins (comma-separated). The CLIENT_URL is included automatically.
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Public base URL of this backend (used to build callback URLs, etc.)
# Leave blank in local dev (defaults to http://localhost:<PORT>)
# Example for production: https://api.yourdomain.com
BACKEND_URL=

# Number of trusted reverse-proxy hops for real client IP detection (rate-limiting).
# 0 = no proxy (direct). 1 = behind one reverse proxy (nginx / PaaS / load balancer).
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Database — MongoDB
# ---------------------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/expense_tracker
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=MyApp
MONGODB_URI=mongodb://127.0.0.1:27017/expense_tracker

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=7d
